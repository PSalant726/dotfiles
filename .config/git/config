[branch]
	sort = -committerdate

[checkout]
	defaultRemote = origin

[color "branch"]
	current = yellow reverse
	local = yellow
	remote = cyan

[color "diff"]
	frag = magenta bold
	meta = yellow bold
	new = green bold
	old = red bold

[color "status"]
	added = green
	changed = yellow
	untracked = cyan

[commit]
	branch = true
	gpgsign = true
	verbose = true

[core]
	pager = delta --side-by-side -w ${FZF_PREVIEW_COLUMNS:-$COLUMNS}

[diff]
	algorithm = histogram
	colorMoved = plain
	mnemonicPrefix = true

[fetch]
	all = true
	prune = true
	pruneTags = true

[help]
	autocorrect = prompt

[init]
	defaultBranch = main

[interactive]
	diffFilter = delta --color-only --features=interactive

[merge]
	conflictstyle = zdiff3
	tool = zed

[mergetool "zed"]
	cmd = zed --wait "$MERGED"

[pull]
	rebase = false

[push]
	autoSetupRemote = true

[rebase]
	autoSquash = true
	autoStash = true
	updateRefs = true

[tag]
	sort = version:refname

[user]
	email = PSalant@gmail.com
	name = Phil Salant
	signingkey = 210DBF9BBAF6FC45

# Delta diff viewer config
[delta]
	features = decorations line-numbers

[delta "decorations"]
	file-decoration-style = magenta ul ol
	file-style = magenta
	hunk-header-style = omit
	minus-style = syntax bold auto
	plus-style = syntax bold auto

[delta "line-numbers"]
	line-numbers = true
	line-numbers-left-style = syntax
	line-numbers-right-style = syntax

